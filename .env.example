APP_NAME=AI Questionnaire
DATABASE_URL=sqlite:///./backend/data/app.db
ADMIN_TOKEN=changeme
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# LLM: ollama | openai_compatible
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible (used when LLM_PROVIDER=openai_compatible)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# SSO (Google/Microsoft). Configure at least one provider to allow public submissions.
# When AUTH_REQUIRED_FOR_SUBMIT=true, users must sign in before submitting.
SESSION_SECRET=change-this-session-secret
AUTH_REQUIRED_FOR_SUBMIT=true
AUTH_REQUIRED_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
